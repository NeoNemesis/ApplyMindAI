# ApplyMind AI — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Provider: openai | anthropic | google | ollama | huggingface | azure | bedrock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# OpenAI API Key — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic (if using Claude) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=your-key-here

# Google Gemini — https://aistudio.google.com/app/apikey
# GOOGLE_API_KEY=your-key-here

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Gmail App Password — https://myaccount.google.com/apppasswords
JOBCRAFT_SMTP_PASSWORD=your-gmail-app-password-here

# ─── LinkedIn (optional — for automated applications) ─────────────────────────
LINKEDIN_EMAIL=your-linkedin-email@example.com
LINKEDIN_PASSWORD=your-linkedin-password

# ─── CV & Letter Settings ─────────────────────────────────────────────────────
# Available designs: design_01_modern | design_02_classic | design_03_minimal
CV_DESIGN=design_02_classic

# Available letter templates: nordic_minimal | professional | modern
LETTER_TEMPLATE=nordic_minimal

# ─── App Settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
PYTHONIOENCODING=utf-8
