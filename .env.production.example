# ApplyMind AI — Produktionsmiljö
# Kopiera till .env.production och fyll i riktiga värden
# ALDRIG committa .env.production till git!

# Flask
FLASK_ENV=production
FLASK_SECRET=BYTA-TILL-64-SLUMPTECKEN-openssl-rand-hex-32

# Databas (PostgreSQL i produktion)
DATABASE_URL=postgresql://applymind:DATABASLÖSENORD@localhost:5432/applymind

# Alternativt SQLite (enklare, OK för färre än 50 användare)
# DATABASE_URL=sqlite:////app/instance/applymind.db

# Admin-konto (används av init_admin.py)
ADMIN_EMAIL=din@epost.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BYTA-DETTA-DIREKT

# Encoding
PYTHONIOENCODING=utf-8
